{
  "Name": "Kubernetes",
  "Description": "Kubernetes node preparation: containerd, kernel bridge tuning, swap disabled, and kubectl/helm tooling.",
  "Packages": [
    "curl",
    "git",
    "jq",
    "tar",
    "tmux",
    "htop",
    "tree",
    "lsof",
    "strace",
    "dnsutils",
    "tcpdump",
    "socat",
    "conntrack",
    "iptables",
    "ebtables",
    "ethtool",
    "ca-certificates"
  ],
  "RunCommands": [
    "swapoff -a",
    "sed -i '/ swap / s/^\\(.*\\)$/#\\1/g' /etc/fstab",
    "modprobe overlay",
    "modprobe br_netfilter",
    "printf 'overlay\\nbr_netfilter\\n' > /etc/modules-load.d/k8s.conf",
    "printf 'net.bridge.bridge-nf-call-iptables = 1\\nnet.ipv4.ip_forward = 1\\nnet.bridge.bridge-nf-call-ip6tables = 1\\n' > /etc/sysctl.d/k8s.conf",
    "sysctl --system",
    "curl -fsSL https://get.docker.com -o /tmp/get-docker.sh",
    "sh /tmp/get-docker.sh",
    "systemctl enable --now docker",
    "usermod -aG docker labadmin",
    "curl -fsSL https://dl.k8s.io/release/v1.30.0/bin/linux/amd64/kubectl -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl",
    "curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash"
  ]
}
